# Copy this file to .env.local and fill in your Supabase project's values
# (Supabase dashboard → Connect → Framework: Next.js → App Router, or
# Project Settings → API).
#
# Both of these are safe to expose to the browser (NEXT_PUBLIC_) — Row
# Level Security, not secrecy of these values, is what protects the data.
# Never put the service_role / secret key in this file or anywhere in the
# app; nothing in this project needs it.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Paid-plan payout handles, shown to sellers who pick a paid plan. Manual
# Cash App / Zelle — an admin confirms the transfer and flips the listing
# live. Safe to expose. Leave unset and paid plans are hidden from the
# post form (free only).
NEXT_PUBLIC_PAY_CASHAPP=$YourCashtag
NEXT_PUBLIC_PAY_ZELLE=you@example.com
