# Copy this file to .env.local and fill in your Supabase project's values
# (Supabase dashboard → Connect → Framework: Next.js → App Router, or
# Project Settings → API).

# ── Public (NEXT_PUBLIC_) — safe to expose ───────────────────────────
# Row Level Security, not secrecy of these values, is what protects the
# data. These ship in the browser bundle.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Paid-plan payout handles, shown to sellers who pick a paid plan. Manual
# Cash App / Zelle — an admin confirms the transfer and flips the listing
# live. Leave unset and paid plans are hidden from the post form.
NEXT_PUBLIC_PAY_CASHAPP=$YourCashtag
NEXT_PUBLIC_PAY_ZELLE=you@example.com

# ── Server-only secrets — NEVER prefix with NEXT_PUBLIC_ ─────────────
# Used only by the inquiry-reminder cron (app/api/cron/inquiry-reminders).
# Set these in Vercel → Project → Settings → Environment Variables, not
# just here. Local dev doesn't hit the cron, so they're optional locally.

# Supabase → Project Settings → API → service_role key. Bypasses RLS —
# the cron needs it to read seller emails from auth.users.
SUPABASE_SERVICE_ROLE_KEY=

# A Resend API key (can be a separate one from the Supabase SMTP key).
# The cron sends the reminder email through Resend's REST API.
RESEND_API_KEY=

# Any long random string. Vercel Cron sends it as a Bearer token; the
# route rejects calls without it. Generate: openssl rand -hex 32
CRON_SECRET=
